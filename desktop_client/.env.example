# ──────────────────────────────────────────────────────────
# Biometric Unlock – Desktop Client Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# .env is gitignored — never commit it.
# ──────────────────────────────────────────────────────────

# Firebase Realtime Database URL (found in Firebase Console → Realtime Database)
FIREBASE_DB_URL=https://YOUR-PROJECT-ID.firebaseio.com

# Absolute or relative path to the Firebase Admin SDK service account JSON key
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Absolute or relative path to the RSA-2048 private key PEM file
PRIVATE_KEY_PATH=./private_key.pem
